# ============================================
# DevLabs CFO - Environment Variables
# ============================================
# Copy this file to .env.local (Next.js convention for Vercel)
# NEVER commit .env.local to version control

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"  # Server-side only, NEVER expose to client

# Direct Database Connection (for Prisma migrations)
DATABASE_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres"

# ============================================
# Xero Integration (OAuth 2.0)
# ============================================
# Get these from: https://developer.xero.com/app/manage
XERO_CLIENT_ID="YOUR_XERO_CLIENT_ID_HERE"
XERO_CLIENT_SECRET="YOUR_XERO_CLIENT_SECRET_HERE"
XERO_REDIRECT_URI="http://localhost:3000/api/integrations/xero/callback"
# For production: https://yourdomain.com/api/integrations/xero/callback

# ============================================
# Mercury Bank Integration
# ============================================
# Get this from: https://app.mercury.com/settings/developers
MERCURY_API_KEY="YOUR_MERCURY_API_KEY_HERE"

# ============================================
# Slack Bot Integration (NEW)
# ============================================
# Get these from: https://api.slack.com/apps
# Create a new Slack App with Bot Token Scopes:
# - channels:history (read channel messages)
# - channels:read (view channels)
# - chat:write (post messages)
# - im:history (read direct messages)
# - im:write (send direct messages)
# - users:read (view users)

SLACK_BOT_TOKEN="xoxb-YOUR-SLACK-BOT-TOKEN-HERE"
SLACK_SIGNING_SECRET="YOUR_SLACK_SIGNING_SECRET_HERE"
SLACK_APP_TOKEN="xapp-YOUR-SLACK-APP-TOKEN-HERE"  # For Socket Mode (optional)
SLACK_CFO_CHANNEL_ID="C123456789"  # #cfo channel ID

# ============================================
# AI Integration (for Slack Bot & Insights)
# ============================================
# Choose ONE of the following:

# Option A: OpenAI (GPT-4)
OPENAI_API_KEY="sk-YOUR-OPENAI-API-KEY-HERE"
AI_PROVIDER="openai"
AI_MODEL="gpt-4-turbo-preview"

# Option B: Anthropic Claude (Recommended)
# ANTHROPIC_API_KEY="sk-ant-YOUR-ANTHROPIC-API-KEY-HERE"
# AI_PROVIDER="anthropic"
# AI_MODEL="claude-3-5-sonnet-20241022"

# ============================================
# Upstash Redis (Optional - for rate limiting)
# ============================================
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token-here"

# ============================================
# Supabase Edge Functions (for background jobs)
# ============================================
SUPABASE_FUNCTION_SECRET="your-function-secret-here"
# Generate with: openssl rand -base64 32
# Used to secure edge function invocations

# ============================================
# Encryption Key (for sensitive OAuth tokens)
# ============================================
ENCRYPTION_KEY="YOUR_32_BYTE_ENCRYPTION_KEY_HERE"
# Generate with: openssl rand -hex 32
# Used for encrypting Xero/Mercury tokens stored in Supabase

# ============================================
# Application Settings
# ============================================
NODE_ENV="development"  # development | production | test
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For production (Vercel): https://your-app.vercel.app

# ============================================
# Email Notifications (Optional)
# ============================================
# Use SendGrid, AWS SES, or similar
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SENDGRID_API_KEY"
EMAIL_FROM="cfo@devlabs.com"

# ============================================
# Vercel Environment
# ============================================
# These are automatically set by Vercel, but can be overridden
VERCEL="1"
VERCEL_ENV="production"  # development | preview | production
VERCEL_URL="your-app.vercel.app"

# ============================================
# Monitoring & Logging (Optional)
# ============================================
# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN="YOUR_SENTRY_DSN_HERE"
SENTRY_AUTH_TOKEN="YOUR_SENTRY_AUTH_TOKEN"

# Vercel Analytics (built-in)
NEXT_PUBLIC_VERCEL_ANALYTICS="true"

# ============================================
# Feature Flags
# ============================================
ENABLE_SLACK_BOT="true"
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_REAL_TIME_UPDATES="true"
ENABLE_AI_INSIGHTS="true"

# ============================================
# Financial Targets (Defaults)
# ============================================
# These can be overridden in the database
DEFAULT_GROSS_MARGIN_TARGET="0.67"  # 67%
DEFAULT_NET_MARGIN_TARGET="0.28"    # 28%
MAX_CONTRACTOR_RATIO="0.40"         # 40%
MAX_TOOL_RATIO="0.10"               # 10%
