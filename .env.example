# ========================================
# DevLabs CFO - Environment Configuration
# ========================================

# ========================================
# Supabase Configuration
# ========================================
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# ========================================
# Xero Integration
# ========================================
XERO_CLIENT_ID="your-xero-client-id"
XERO_CLIENT_SECRET="your-xero-client-secret"
XERO_REDIRECT_URI="https://your-domain.com/api/xero/oauth/callback"
XERO_TOKEN_ENCRYPTION_KEY="base64:generate-with-node-crypto"
CRON_SECRET="generate-with-node-crypto-hex"

# ========================================
# Mercury Bank Integration
# ========================================
MERCURY_API_KEY="your-mercury-api-key"

# ========================================
# Slack Integration
# ========================================
SLACK_BOT_TOKEN="your-slack-bot-token"
SLACK_SIGNING_SECRET="your-slack-signing-secret"
SLACK_CFO_CHANNEL_ID="your-channel-id"

# ========================================
# AI Provider (Choose One)
# ========================================
AI_PROVIDER="anthropic"
AI_MODEL="claude-3-5-sonnet-20241022"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ========================================
# Security Keys
# ========================================
ENCRYPTION_KEY="your-encryption-key"
SUPABASE_FUNCTION_SECRET="your-function-secret"

# ========================================
# Environment
# ========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
